/Makefile
/mypy.ini
/pytest.ini
/.flake8
/.pre-commit-config.yaml
/.gitignore
/.comfyignore
/requirements-dev.txt
/TESTING.md
/concepts_brief.md
/CLAUDE.md
/AGENTS.md
